<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Thumbcrowd — AI-based CX for brands and retailers</title>
    <link rel="stylesheet" href="./styles.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="#" class="logo" aria-label="Thumbcrowd Logo">
          <% if @global_config['LOGO'].present? %>
            <img src="<%= @global_config['LOGO'] %>" alt="<%= @global_config['INSTALLATION_NAME'] || 'ThumbCrowd' %>" class="logo"> 
          <% end %>
        </a>

        <nav class="main-nav" aria-label="Primary" style="display:none;">
          <a href="#">Product</a>
          <a href="#">Solutions</a>
          <a href="#">Resources</a>
          <a href="#">Pricing</a>
        </nav>

        <div class="header-cta">
          <a class="link-muted" href="/app/login">Login</a>
          <button class="btn btn-outline">Talk to Sales</button>
          <button class="btn" href="/app/auth/signup">Try for free</button>
        </div>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container text-center">
          <h1 class="serif mb-48">
            An AI-based CX enterprise <br class="hide-sm" />
            solution for brands and retailers
          </h1>

          <div class="actions mt-48">
            <button class="btn btn-lg">Try for free</button>
          </div>

          <div class="m-48">
            <p class="lede">
              ThumbCrowd empowers customer service leaders to deliver efficient,
              high‑quality support at scale with an AI agent—continuously improving
              the speed and quality of results across all channels and languages, 24/7.
            </p>
          </div>

          <div class="hero-video-wrapper-div">
           <img src="/index/ui.png" loading="lazy" alt="" srcset="/index/ui.png 500w, /index/ui.png 1138w" class="border-radius-20">
          </div>

          <div class="ales mt-48">
            <h2 class="serif">Supercharge Your Sales with Chat Marketing</h2>
            <div class="">
              <p class="muted">
                Unlock the potential of Instagram, WhatsApp, and Messenger with cutting‑edge chat automation.
              </p>
            </div>
          </div>

          <div class="features">
            <article class="card card-tint">
              <div class="card-icon bg-green">
              <img src="/index/channels_whatsapp.svg" loading="lazy" alt="icon">
              </div>
              <h3>WhatsApp</h3>
              <p>
                Use WhatsApp Automations to help customers discover products,
                resolve order information and deliver support—on autopilot.
              </p>
              <div class="link-card"><a href="#" class="link-inline">Learn more →</a></div>
            </article>
            <article class="card card-tint">
              <div class="card-icon bg-pink">
                <img src="/index/channels_instagram-dm.svg" loading="lazy" alt="icon">
              </div>
              <h3>Instagram DMs</h3>
              <p>
                Answer every question, comment, and story reply 24/7. Automate replies and drive higher conversions on IG.
              </p>
              <div class="link-card"><a href="#" class="link-inline">Learn more →</a></div>
            </article>
            <article class="card card-tint">
              <div class="card-icon bg-blue">
                <img src="/index/channels_facebook.svg" loading="lazy" alt="icon">
              </div>
              <h3>Facebook Messenger</h3>
              <p>
                Automate conversations to fuel more sales, generate leads, auto‑answer FAQs, and run marketing campaigns.
              </p>
              <div class="link-card"><a href="#" class="link-inline">Learn more →</a></div>
            </article>
          </div>

        </div>
      </section>

      <section>
        <div class="clients_logo m-48" aria-label="Trusted by logos">
          <span><img src="/index/clientlogos/cheetay.svg" loading="lazy" alt="CHEETAY"></span>
          <span><img src="/index/clientlogos/AliMedical.svg" loading="lazy" alt="ALIMEDICAL"></span>
          <span><img src="/index/clientlogos/evercare.svg" loading="lazy" alt="EVERCARE"></span>
          <span><img src="/index/clientlogos/FBISE.svg" loading="lazy" alt="FBISE"></span>
          <span><img src="/index/clientlogos/Gharpar.svg" loading="lazy" alt="GHARPAR"></span>
          <span><img src="/index/clientlogos/InstalmentPk.svg" loading="lazy" alt="INSTALMENTPK"></span>
          <span><img src="/index/clientlogos/LM.svg" loading="lazy" alt="LECOLEMONDIALE"></span>
          <span><img src="/index/clientlogos/MG.svg" loading="lazy" alt="MELBOURNEWELLNESS"></span>
          <span><img src="/index/clientlogos/SaadAhssan.svg" loading="lazy" alt="SAADAHSAN"></span>
          <span><img src="/index/clientlogos/dawaai.svg" loading="lazy" alt="DAWAAI"></span>
          <span><img src="/index/clientlogos/CLH.svg" loading="lazy" alt="CHUGHTAI"></span>
          <span><img src="/index/clientlogos/rizq.svg" loading="lazy" alt="RIZQ"></span>
        </div>
      </section>
      <section class="section section-green-100">
        <div class="container text-center p-48">
          <h1 class="section-h1">
            Meet ALY~AI: Your <br class="hide-sm" /> Ultimate Support Member
          </h1>
          <p class="muted max-w-720 center">
            ThumbCrowd redefines customer support with seamless device integration and Robin‑AI at its core. Empower agents to work faster, respond smarter, and deliver personalized interactions.
          </p>
        </div>

        <div class="container-flex v-center mt-48">
          <div class="w-48 pr-48">
            <h3 class="h3">Increase agent efficiency with Copilot</h3>
