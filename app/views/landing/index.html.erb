     </main>
      <!-- AI Features Section -->
        <section class="section ai-features-section" style="background: #0a0a0a; color: white; padding: 80px 0; margin-top:200px">
          <div class="container text-center">
            <div class="ai-hero-content">
              <div class="sparkle-icon" style="font-size: 2rem; margin-bottom: 1rem;">✨</div>
              <h1 style="font-size: 3rem; font-weight: 400; margin-bottom: 1rem; line-height: 1.2;">Create Effortlessly with AI</h1>
              <p style="color: #a0a0a0; font-size: 1.1rem; margin-bottom: 3rem;">Supercharge your workflow with ThumbCrowd AI.</p>
            </div>

            <div class="ai-features-grid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; margin-bottom: 4rem;">
              <!-- Conversation Summaries -->
              <div class="ai-feature-card" style="background: #1a1a1a; border-radius: 16px; padding: 2rem; text-align: left;">
                <div class="feature-header" style="margin-bottom: 1.5rem;">
                  <h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem;">Conversation summaries and next steps</h3>
                  <p style="color: #a0a0a0; font-size: 0.9rem; line-height: 1.4;">ThumbCrowd Copilot automatically summarizes conversations, audios, then intelligently suggests next steps.</p>
                </div>
                
                <div class="call-summary-mockup" style="background: #2a2a2a; border-radius: 12px; padding: 1rem;">
                  <div class="call-header" style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; font-size: 0.85rem; color: #888;">
                    <div class="avatar" style="width: 24px; height: 24px; border-radius: 50%; background: #4a5568;"></div>
                    <span>📞 Call ended</span>
                    <span style="margin-left: auto;">Thu Jan 9 at 9:30</span>
                  </div>
                  
                  <div class="ai-summary" style="background: #6366f1; border-radius: 8px; padding: 0.75rem; margin-bottom: 1rem;">
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; font-size: 0.8rem; font-weight: 600;">
                      <span>✨</span>
                      <span>Call summary</span>
                      <span style="font-size: 0.7rem; background: rgba(255,255,255,0.2); padding: 0.2rem 0.4rem; border-radius: 4px;">Powered by ThumbCrowd AI</span>
                    </div>
                    <ul style="font-size: 0.8rem; line-height: 1.4; margin: 0; padding-left: 1rem;">
                      <li>Angela called Amy to hear her thoughts on the date</li>
                      <li>Amy suggests reaching out to the client to clarify details</li>
                      <li>Angela is busy with meetings later in the day but is available</li>
                    </ul>
                  </div>
                  
                  <div class="next-steps" style="font-size: 0.8rem;">
                    <div style="color: #6366f1; font-weight: 600; margin-bottom: 0.5rem;">Next steps:</div>
                    <ul style="color: #ccc; line-height: 1.4; margin: 0; padding-left: 1rem;">
                      <li>Angela will reach out to the client and set up a call to clarify details</li>
                      <li>Amy will check her schedule to confirm whether she can attend the client call</li>
                    </ul>
                  </div>
                </div>
              </div>

              <!-- Automatic Audio Transcripts -->
              <div class="ai-feature-card" style="background: #1a1a1a; border-radius: 16px; padding: 2rem; text-align: left;">
                <div class="feature-header" style="margin-bottom: 1.5rem;">
                  <h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem;">Automatic audio message transcripts</h3>
                  <p style="color: #a0a0a0; font-size: 0.9rem; line-height: 1.4;">Quickly scan, search, and instantly reference or find info with time-stamps.</p>
                </div>
                
                <div class="transcript-mockup" style="background: #2a2a2a; border-radius: 12px; padding: 1rem;">
                  <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
                    <span style="background: #6366f1; color: white; padding: 0.3rem 0.6rem; border-radius: 6px; font-size: 0.8rem; font-weight: 600;">✨ Call transcript</span>
                  </div>
                  
                  <div class="transcript-messages" style="display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.85rem;">
                    <div style="display: flex; gap: 0.5rem;">
                      <span style="color: #888; min-width: 2rem;">0:01</span>
                      <span><strong>Angela Campbell:</strong> Hello, this is Angela speaking.</span>
                    </div>
                    <div style="display: flex; gap: 0.5rem;">
                      <span style="color: #888; min-width: 2rem;">0:05</span>
                      <span><strong>Ruth Henderson:</strong> Hi Angela, this is Ruth. How are you?</span>
                    </div>
                    <div style="display: flex; gap: 0.5rem;">
                      <span style="color: #888; min-width: 2rem;">0:09</span>
                      <span><strong>Angela Campbell:</strong> Oh hi Ruth, I'm doing well, thanks for asking. How about you?</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Suggested Contacts -->
              <div class="ai-feature-card" style="background: #1a1a1a; border-radius: 16px; padding: 2rem; text-align: left;">
                <div class="feature-header" style="margin-bottom: 1.5rem;">
                  <h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem;">Suggested contacts</h3>
                  <p style="color: #a0a0a0; font-size: 0.9rem; line-height: 1.4;">Easily add new contacts with suggestions based on call and voicemail transcripts.</p>
                </div>
                
                <div class="contact-suggestion-mockup" style="background: #2a2a2a; border-radius: 12px; padding: 1rem;">
                  <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
                    <span style="background: #6366f1; color: white; padding: 0.3rem 0.6rem; border-radius: 6px; font-size: 0.8rem; font-weight: 600;">✨ Contact suggestion</span>
                  </div>
                  
                  <div class="contact-card" style="background: white; color: black; border-radius: 8px; padding: 1rem; text-align: center;">
                    <div class="contact-avatar" style="width: 60px; height: 60px; border-radius: 50%; background: #e2e8f0; margin: 0 auto 1rem; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; color: #64748b;">👤</div>
                    <h4 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 0.5rem;">Angela Campbell</h4>
                    <div class="contact-details" style="font-size: 0.9rem; color: #64748b; margin-bottom: 1rem;">
                      <div style="display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin-bottom: 0.25rem;">
                        <span>📞</span>
                        <span>Phone: (269) 682-1892</span>
                      </div>
                      <div style="display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin-bottom: 0.25rem;">
                        <span>🏢</span>
                        <span>Company: Icecap</span>
                      </div>
                      <div style="display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                        <span>👤</span>
                        <span>Role: Product Manager</span>
                      </div>
                    </div>
                    <button style="background: #e2e8f0; color: #1a1a1a; border: none; padding: 0.5rem 1rem; border-radius: 6px; font-size: 0.9rem; font-weight: 500; cursor: pointer;">Save to contacts</button>
                  </div>
                </div>
              </div>

              <!-- AI Call Tags -->
              <div class="ai-feature-card" style="background: #1a1a1a; border-radius: 16px; padding: 2rem; text-align: left;">
                <div class="feature-header" style="margin-bottom: 1.5rem;">
                  <h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem;">AI conversation tags</h3>
                  <p style="color: #a0a0a0; font-size: 0.9rem; line-height: 1.4;">Define your tags, and our AI automatically suggest them to relevant conversations you stay focused on what matters.</p>
                </div>
                
                <div class="call-tags-mockup" style="background: #2a2a2a; border-radius: 12px; padding: 1rem;">
                  <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
                    <span style="background: #6366f1; color: white; padding: 0.3rem 0.6rem; border-radius: 6px; font-size: 0.8rem; font-weight: 600;">✨ Call tag</span>
                    <span style="color: #888; font-size: 0.8rem; margin-left: auto;">Coming soon</span>
                  </div>
                  
                  <div class="call-entry" style="background: white; color: black; border-radius: 8px; padding: 1rem;">
                    <div class="call-header" style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
                      <div style="width: 32px; height: 32px; border-radius: 50%; background: #e2e8f0; display: flex; align-items: center; justify-content: center;">📞</div>
                      <div>
                        <div style="font-weight: 600; font-size: 0.9rem;">Call ended</div>
                        <div style="color: #64748b; font-size: 0.8rem;">Ruth answered • 15:28</div>
