                  <div style="background: #e2e8f0; height: 6px; border-radius: 3px; width: 80%;"></div>
                </div>
                <div style="background: #f8fafc; padding: 16px; border-radius: 8px;">
                  <div style="background: #48bb78; height: 8px; border-radius: 4px; width: 40%; margin-bottom: 8px;"></div>
