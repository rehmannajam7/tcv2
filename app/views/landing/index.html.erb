            <p class="mt-12">
              Keep track of important details with custom properties and notes. One shared address book allows your team to have everything they need before getting in touch.
            </p>
          </div>

          <div>
            <div class="window">
              <img src="/index/contact-details.png" loading="lazy" alt="contact">
            </div>
          </div>
        </div>
      </section>

      <section class="section section-white-000 p-20">
        <div class="features-grid-2 section-black-100 gap-145 border-radius-20">
          <div class="p-48 feature-section">
            <h1 class="serif mb-48" style="color: #fff; font-weight: 100;">Customers report 17% CSAT improvement when using copilot.</h1>
          </div>
          <div>
            <div class="window" style="width: 100% !important;">
                <img src="/index/happyface.png" loading="lazy" alt="contact">
              </div>
          </div>
        </div>  
      </section>



