<!-- Header Section -->
<header class="header">
  <div class="container">
    <div class="header-content">
      <div class="logo-container">
        <% if @global_config['LOGO'].present? %>
          <img src="<%= @global_config['LOGO'] %>" alt="<%= @global_config['INSTALLATION_NAME'] || 'ThumbCrowd' %>" class="logo">
        <% else %>
          <h2 style="margin: 0; color: var(--primary-purple); font-weight: 700;"><%= @global_config['INSTALLATION_NAME'] || 'ThumbCrowd' %></h2>
        <% end %>
      </div>
      
      <nav class="nav-menu">
        <a href="#product">Product</a>
        <a href="#solutions">Solutions</a>
        <a href="#resources">Resources</a>
        <a href="#pricing">Pricing</a>
      </nav>
      
      <div class="header-buttons">
        <%= link_to "Login", "/app/login", class: "btn btn-login" %>
        <%= link_to "Try for free", "/app/auth/signup", class: "btn btn-cta" %>
      </div>
    </div>
  </div>
</header>

<!-- Updated Hero Section -->
